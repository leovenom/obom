# =============================================================================
# OBOM — copie para .env (nunca commite .env com valores reais)
# Guia de deploy: docs/DEPLOY.md
# Google OAuth: docs/GOOGLE-OAUTH.md
# =============================================================================

# --- Obrigatório em produção -------------------------------------------------
# Segredo de sessão Auth.js / NextAuth (openssl rand -base64 32)
AUTH_SECRET=
# Alternativa aceite: NEXTAUTH_SECRET=

# URL pública HTTPS da app (sem barra final), ex.: https://obom.example.com
NEXTAUTH_URL=

# Senha do dashboard admin (/dashboard) — use valor forte, não o exemplo
ADMIN_PASSWORD=

# --- Opcional: login Google --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Opcional: servidor ------------------------------------------------------
PORT=3001

# --- Opcional: comissionamento (simulação) -----------------------------------
USER_COMMISSION_PCT=30
PLATFORM_COMMISSION_PCT=10
PLATFORM_NAME=OBOM
PLATFORM_CNPJ=
PLATFORM_CONTACT=contato@obom.com.br

# --- Opcional: serviço de placas (Python, porta 5050) ------------------------
# npm run plates:dev — se offline, o browser usa OCR Tesseract
# PLATE_SERVICE_URL=http://127.0.0.1:5050
